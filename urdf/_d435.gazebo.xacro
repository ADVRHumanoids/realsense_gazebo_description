License: Apache 2.0. See LICENSE file in root directory.
Copyright(c) 2017 PAL Robotics, S.L. All Rights Reserved

This is the Gazebo URDF model for the Intel RealSense D435 camera
-->
  
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:macro name="gazebo_d435" params="
                                          camera_name:=camera
                                          
                                          color_frame
                                          depth_frame
                                          infrared1_frame
                                          infrared2_frame

                                          depth_optical_frame
                                          color_optical_frame
                                          infrared1_optical_frame
                                          infrared2_optical_frame

                                          clip_distance:=-1.0
                                          clip_distance_min:=0.195
                                          depth_width:=848
                                          depth_height:=480
                                          depth_fps:=30
                                          depth_fx:= 431.2745666503906
                                          depth_fy:= 431.2745666503906
                                          depth_cx:= 423.82025146484375
                                          depth_cy:= 241.2349395751953 

                                          enable_infrared:=false
                                          infra_width:=640
                                          infra_height:=480
                                          infra_fps:=30
                                          infra_fx:= 431.2745666503906
                                          infra_fy:= 431.2745666503906
                                          infra_cx:= 423.82025146484375
                                          infra_cy:= 241.2349395751953
                                          infra2_tx:= -21.57023811340332

                                          color_width:=640
                                          color_height:=480
                                          color_fps:=30
                                          color_fx:= 606.4806518554688
                                          color_fy:= 606.4366455078125
                                          color_cx:= 326.2506103515625
                                          color_cy:= 254.5507049560547

                                          align_depth:=false
                                          visualize:=false
                                          ">

    <!-- Load parameters to model's main link-->
    <xacro:property name="deg_to_rad" value="0.01745329251994329577" />
    <xacro:property name="INFRARED" value="${enable_infrared}" />

    <!-- COLOR CAMERA -->
    
    <gazebo reference="${color_frame}">
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <!--<gravity>1</gravity>-->
      <!--<mu>1</mu>-->
      <mu2>1</mu2>
      <fdir1>0 0 0</fdir1>
      <!--<slip1>0</slip1>
      <slip2>0</slip2>-->
      <kp>1e+13</kp>
      <kd>1</kd>
      <!--<max_vel>0.01</max_vel>
      <min_depth>0</min_depth>-->
      <sensor name="${camera_name}_color" type="camera">
        <gz_frame_id>${color_frame}</gz_frame_id>
        <topic>${camera_name}/color/image_raw</topic>
        <camera name="${camera_name}">
          <camera_info_topic>${camera_name}/color/camera_info</camera_info_topic>
          <optical_frame_id>${color_optical_frame}</optical_frame_id>
          <horizontal_fov>${69.4*deg_to_rad}</horizontal_fov>
          <image>
            <width>${color_width}</width>
            <height>${color_height}</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <!-- <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise> -->
          <lens>
            <projection>
              <p_fx>${color_fx}</p_fx>
              <p_fy>${color_fy}</p_fy>
              <p_cx>${color_cx}</p_cx>
              <p_cy>${color_cy}</p_cy>
              <tx>0</tx>
              <ty>0</ty>
            </projection>
            <intrinsics>
              <fx>${color_fx}</fx>
              <fy>${color_fy}</fy>
              <cx>${color_cx}</cx>
              <cy>${color_cy}</cy>
              <s>0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>${color_fps}</update_rate>
        <visualize>${visualize}</visualize>
      </sensor>
    </gazebo>


    <!-- INFRARED -->
    
    <xacro:if value="${INFRARED}">
      <gazebo reference="${infrared1_frame}">
        <sensor name="${camera_name}_ired1" type="camera">
          <gz_frame_id>${infrared1_frame}</gz_frame_id>
          <topic>${camera_name}/infra1/image_raw</topic>
          <camera name="${camera_name}_ired1">
            <optical_frame_id>${infrared1_optical_frame}</optical_frame_id>
            <horizontal_fov>${85.2*deg_to_rad}</horizontal_fov>
            <image>
              <width>${infra_width}</width>
              <height>${infra_height}</height>
              <format>L_INT8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.02</stddev>
            </noise>
            <lens>
              <projection>
                <p_fx>${infra_fx}</p_fx>
                <p_fy>${infra_fy}</p_fy>
                <p_cx>${infra_cx}</p_cx>
                <p_cy>${infra_cy}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
              <intrinsics>
                <fx>${infra_fx}</fx>
                <fy>${infra_fy}</fy>
                <cx>${infra_cx}</cx>
                <cy>${infra_cy}</cy>
                <s>0</s>
              </intrinsics>
            </lens>
          </camera>
          <always_on>1</always_on>
          <update_rate>${infra_fps}</update_rate>
          <visualize>false</visualize>
        </sensor>
      </gazebo>

      <gazebo reference="${infrared2_frame}">
        <sensor name="${camera_name}_ired2" type="camera">
          <gz_frame_id>${infrared1_frame}</gz_frame_id>
          <topic>${camera_name}/infra2/image_raw</topic>
          <camera name="${camera_name}_ired2">
            <optical_frame_id>${infrared2_optical_frame}</optical_frame_id>
            <horizontal_fov>${85.2*deg_to_rad}</horizontal_fov>
            <image>
              <width>${infra_width}</width>
              <height>${infra_height}</height>
              <format>L_INT8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.02</stddev>
            </noise>
            <lens>
              <projection>
                <p_fx>${infra_fx}</p_fx>
                <p_fy>${infra_fy}</p_fy>
                <p_cx>${infra_cx}</p_cx>
                <p_cy>${infra_cy}</p_cy>
                <tx>${infra2_tx}</tx>
                <ty>0</ty>
              </projection>
              <intrinsics>
                <fx>${infra_fx}</fx>
                <fy>${infra_fy}</fy>
                <cx>${infra_cx}</cx>
                <cy>${infra_cy}</cy>
                <s>0</s>
              </intrinsics>
            </lens>
          </camera>
          <always_on>1</always_on>
          <update_rate>${infra_fps}</update_rate>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:if>


    <!-- DEPTH CAMERA ALIGNED -->

    <xacro:if value="${align_depth}">
      <gazebo reference="${color_frame}">
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
        <mu2>1</mu2>
        <fdir1>0 0 0</fdir1>
        <kp>1e+13</kp>
        <kd>1</kd>
        <sensor name="${camera_name}_depth" type="depth">
          <topic>${camera_name}/aligned_depth_to_color/image_raw</topic>
          <gz_frame_id>${color_frame}</gz_frame_id>
          <camera name="${camera_name}_aligned_depth_camera">
            <camera_info_topic>${camera_name}/aligned_depth_to_color/camera_info</camera_info_topic>
            <optical_frame_id>${color_optical_frame}</optical_frame_id>
            <horizontal_fov>${69.4*deg_to_rad}</horizontal_fov>
            <image>
              <width>${color_width}</width>
              <height>${color_height}</height>
            </image>
            <clip>
              <near>${clip_distance_min}</near>
              <xacro:unless value="${clip_distance > 0.0}">
                <far>10</far>
              </xacro:unless>
              <xacro:if value="${clip_distance > 0.0}">
                <far>${clip_distance}</far>
              </xacro:if>
            </clip>
            <lens>
              <projection>
                <p_fx>${color_fx}</p_fx>
                <p_fy>${color_fy}</p_fy>
                <p_cx>${color_cx}</p_cx>
                <p_cy>${color_cy}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
              <intrinsics>
                <fx>${color_fx}</fx>
                <fy>${color_fy}</fy>
                <cx>${color_cx}</cx>
                <cy>${color_cy}</cy>
                <s>0</s>
              </intrinsics>
            </lens>
          </camera>
          <always_on>1</always_on>
          <update_rate>${color_fps}</update_rate>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- DEPTH CAMERA NOT ALIGNED -->

    <xacro:unless value="${align_depth}">
      <gazebo reference="${depth_frame}">
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
        <mu2>1</mu2>
        <fdir1>0 0 0</fdir1>
        <kp>1e+13</kp>
        <kd>1</kd>
        <sensor name="${camera_name}_depth" type="depth">
          <topic>${camera_name}/depth/image_raw</topic>
          <gz_frame_id>${depth_frame}</gz_frame_id>
          <camera name="${camera_name}_depth_camera">
            <camera_info_topic>${camera_name}/depth/camera_info</camera_info_topic>
            <optical_frame_id>${depth_optical_frame}</optical_frame_id>
            <horizontal_fov>${85.2*deg_to_rad}</horizontal_fov>
            <image>
              <width>${depth_width}</width>
              <height>${depth_height}</height>
            </image>
            <clip>
              <near>${clip_distance_min}</near>
              <xacro:unless value="${clip_distance > 0.0}">
                <far>10</far>
              </xacro:unless>
              <xacro:if value="${clip_distance > 0.0}">
                <far>${clip_distance}</far>
              </xacro:if>
            </clip>
            <lens>
              <projection>
                <p_fx>${depth_fx}</p_fx>
                <p_fy>${depth_fy}</p_fy>
                <p_cx>${depth_cx}</p_cx>
                <p_cy>${depth_cy}</p_cy>
                <tx>0</tx>
                <ty>0</ty>
              </projection>
              <intrinsics>
                <fx>${depth_fx}</fx>
                <fy>${depth_fy}</fy>
                <cx>${depth_cx}</cx>
                <cy>${depth_cy}</cy>
                <s>0</s>
              </intrinsics>
            </lens>
          </camera>
          <always_on>1</always_on>
          <update_rate>${depth_fps}</update_rate>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:unless>

  </xacro:macro>
</robot>
